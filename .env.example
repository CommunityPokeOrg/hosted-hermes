# --- Hosted Hermes configuration ---

# Admin account seeded on first boot
HH_ADMIN_EMAIL=admin@example.com
HH_ADMIN_PASSWORD=change-me-in-production

# Where the file-backed store persists state (JSON)
HH_STORE_PATH=./data/hosted-hermes.json

# Provisioner driver: "docker" or "mock"
HH_PROVISIONER=mock

# Docker driver settings (HH_PROVISIONER=docker)
HH_DOCKER_SOCKET=/var/run/docker.sock
# Or use TCP instead of a socket:
# HH_DOCKER_HOST=tcp://127.0.0.1:2375

# Image used for agent containers
HH_AGENT_IMAGE=ghcr.io/communitypokeorg/hermes-agent:latest

# Optional bearer token agents use to call back into this API
HH_AGENT_CALLBACK_TOKEN=

# Session lifetime in seconds (default 7 days)
HH_SESSION_TTL=604800

# Network name containers are attached to (docker driver)
HH_DOCKER_NETWORK=hosted-hermes
